# Configurções da Aplicação
APP_NAME=SiteCopav
APP_ENV=local # Ambiente de execução
APP_KEY= # Chave de segurança (tem que gerar via 'php artisan key:generate')
APP_DEBUG=true # Exibe erros detalhados na tela
APP_URL=http://localhost:8000 # URL base do projeto no navegador

APP_LOCALE=en # Idioma padrão dos textos e validações do sistema
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US # Idioma para geração de dados do Faker

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco de dados
DB_CONNECTION=mysql # Driver de banco (mysql, pgsql, sqlite, etc.)
DB_HOST=127.0.0.1 # IP de conexão (localhost)
DB_PORT=3306 # Porta do MySQL
DB_DATABASE=sitecopav # Nome do banco de dados no seu Gerenciador/Laragon
DB_USERNAME=root # Usuário padrão do MySQL
DB_PASSWORD= # Senha do MySQL (no Laragon o padrão é vazio)


SESSION_DRIVER=database # Onde as sessões dos usuários serão armazenadas (file, database, cookie)
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local # Local onde arquivos/uploads serão salvos
QUEUE_CONNECTION=database

CACHE_STORE=database # Onde o cache do sistema será salvo
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# CONFIGURAÇÕES DE ENVIO DE E-MAIL
MAIL_MAILER=log # Alterar para 'smtp' no caso de enviar e-mails de verdade
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Amazon Web Services (AWS S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Compilador front-end (VITE)
VITE_APP_NAME="${APP_NAME}"